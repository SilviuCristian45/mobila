{
  "name": "roomcraft",
  "version": "0.0.0",
  "private": true,
  "description": "RoomCraft (nume provizoriu) — aplicație web de amenajări interioare. Etapa 1a: fundația proiectului.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:base": "cross-env NEXT_PUBLIC_BASE_PATH=/rc-test RC_DIST_DIR=out-base next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "license:check": "node scripts/license-check.mjs",
    "license:notices": "node scripts/license-check.mjs --notices THIRD_PARTY_NOTICES.md",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:base": "cross-env RC_PREFIX=/rc-test RC_DIR=out-base playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm depcruise && pnpm license:check && pnpm test && pnpm build",
    "verify:e2e": "pnpm build && pnpm e2e && pnpm build:base && pnpm e2e:base && pnpm e2e:storage",
    "e2e:storage:build": "node scripts/build-harness.mjs",
    "e2e:storage": "pnpm e2e:storage:build && playwright test -c playwright.storage.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "dexie": "4.4.7",
    "immer": "11.2.9",
    "konva": "10.9.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "4.1.12",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "jsdom": "27.4.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
